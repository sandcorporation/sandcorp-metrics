# 운영 .env 예시. 실제 파일은 Jenkins 워크스페이스(oracle 호스트의
# /var/jenkins_home/workspace/sandcorp-metrics/.env)에만 둔다. 저장소에 넣지 않는다.
# 로컬 `make prod-local`: 이 파일을 .env로 복사해 값을 채우고 DJANGO_ALLOWED_HOSTS에 localhost를 앞에 둔다.

# Django
# 비밀 키(50자 이상 무작위). 만들기: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-50-random-chars
# 허용 호스트(쉼표). 첫 항목을 헬스체크가 Host로 쓴다.
DJANGO_ALLOWED_HOSTS=metrics.sandcorp.co.kr
# admin 폼 POST의 출처(https://...).
DJANGO_CSRF_TRUSTED_ORIGINS=https://metrics.sandcorp.co.kr
# Django admin 경로(추측하기 어려운 값, 앞뒤 / 생략 가능). 비우면 기동하지 않는다.
DJANGO_ADMIN_PATH=change-me-admin-path
# 개발 모드(1이면 디버그·평문 쿠키 허용). 운영 compose가 0으로 고정한다.
# DJANGO_DEBUG=0
# collectstatic 출력 위치(이미지 안 기본값이면 충분).
# DJANGO_STATIC_ROOT=/app/backend/staticfiles
# 로그 수준(기본 INFO).
# DJANGO_LOG_LEVEL=INFO
# gunicorn 워커 수(기본 2).
# GUNICORN_WORKERS=2

# 이 서비스의 바깥 주소(끝 / 생략). 리소스 URL·admin 로그인 콜백의 기준.
SITE_URL=https://metrics.sandcorp.co.kr
# 클라이언트 IP를 X-Forwarded-For 오른쪽에서 몇 번째로 읽을지(NPMplus 1개 = 1).
PROXY_HOPS=1
# 스케줄러 주기(초, 기본 3600 = 매시간).
SCHEDULER_INTERVAL=3600

# sandcorp-auth(리소스 서버). 토큰의 iss가 AUTH_ISSUER, aud가 AUTH_RESOURCE와 같아야 받는다.
AUTH_ISSUER=https://auth.sandcorp.co.kr
# 리소스 URL(기본 {SITE_URL}/mcp). sandcorp-auth에 같은 값으로 리소스를 등록한다.
AUTH_RESOURCE=https://metrics.sandcorp.co.kr/mcp
# 대표 username. 이 sub의 토큰만 관리 API·MCP·admin 로그인을 쓴다. 비우면 그 경로들이 503.
AUTH_OWNER_SUB=farrar142
# admin 로그인용 기밀 클라이언트(sandcorp-auth에 등록, 리다이렉트 URI
# {SITE_URL}/{DJANGO_ADMIN_PATH}/oauth/callback/). 비우면 admin 로그인만 503.
AUTH_CLIENT_ID=
AUTH_CLIENT_SECRET=

# DB: OCI MySQL HeatWave(사설 IP)의 `metrics` DB. utf8mb4 / utf8mb4_0900_as_cs로 만들어 둔다.
# `make prod-local`은 docker-compose.prod-local.yml이 DB_HOST·DB_PORT를 로컬 MySQL로 덮는다.
DB_HOST=10.0.0.x
DB_PORT=3306
DB_NAME=metrics
DB_USER=metrics
DB_PASSWORD=change-me

# web 바인딩(기본: prod 127.0.0.1:18094, oracle 덮어쓰기 172.17.0.1:18094).
# HTTP_BIND=172.17.0.1
# HTTP_PORT=18094
